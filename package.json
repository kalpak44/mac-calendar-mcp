{
  "name": "mac-calendar-mcp",
  "version": "0.2.25",
  "license": "MIT",
  "description": "Local MCP server for reading events from macOS Calendar",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24.0.0",
    "swift": ">=6.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "webpack": "^5.112.1",
    "webpack-cli": "^7.2.3"
  }
}
